graph TB
    subgraph "GrowthBook Platform"
        UI[Web Dashboard]
        API[API Server]
        DB[(MongoDB/PostgreSQL)]
    end
    
    subgraph "Application Layer"
        SDK[GrowthBook SDK]
        Cache[Local Cache]
    end
    
    subgraph "Data Layer"
        Analytics[Analytics System]
        Metrics[Metrics Storage]
    end
    
    UI --> API
    API --> DB
    SDK --> API
    SDK --> Cache
    API --> Analytics
    Analytics --> Metrics
    
    classDef platform fill:#e3f2fd,stroke:#1976d2,color:#000
    classDef app fill:#f3e5f5,stroke:#7b1fa2,color:#000
    classDef data fill:#e8f5e9,stroke:#388e3c,color:#000
    
    class UI,API,DB platform
    class SDK,Cache app
    class Analytics,Metrics data